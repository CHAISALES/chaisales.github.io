    return '<div style="font:14px/1.5 Arial,sans-serif"><p>Status: <b>' + esc(status) + '</b></p><p>' + ctx + '</p><p>Nota geral: <b>' + r.geral + '</b> (' + r.nivel.nome + ')<br>' +
      r.areas.map(function (a) { return esc(a.nome) + ': ' + a.nota; }).join('<br>') + '</p><h3>Respostas abertas</h3>' + abertas + '</div>';
  }

  return { calcular: calcular, relatorioHtml: relatorioHtml, relatorioTexto: relatorioTexto, adminHtml: adminHtml, esc: esc };
})();

if (typeof module !== 'undefined') module.exports = RX;


// ===== Servidor (Apps Script) =====
// Planilha: abas "Vendas" e "Respostas". Propriedades do script: SECRET (gerada no setup).
var ADMIN = 'chaianesv@corujacriativatech.com.br';
var REMETENTE = 'chaianesv@corujacriativatech.com.br'; // usado se o alias "Enviar como" existir no Gmail
var PRODUTO = 'Raio-X'; // trecho do nome do produto na Kiwify

var COLS_RESP = ['data', 'id', 'status', 'email', 'nome', 'cargo', 'instituicao', 'tipo', 'alunos', 'cidade', 'nota_geral', 'nivel',
  'contato', 'visita', 'relacionamento', 'rematricula', 'pedagogico', 'a1', 'a2', 'a3', 'a4', 'respostas_json'];
var COLS_VENDAS = ['data', 'pedido', 'status', 'email', 'nome', 'produto', 'usado'];

function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  [['Respostas', COLS_RESP], ['Vendas', COLS_VENDAS]].forEach(function (x) {
    var sh = ss.getSheetByName(x[0]) || ss.insertSheet(x[0]);
    if (sh.getLastRow() === 0) { sh.appendRow(x[1]); sh.setFrozenRows(1); }
  });
  var p = PropertiesService.getScriptProperties();
  if (!p.getProperty('SECRET')) p.setProperty('SECRET', Utilities.getUuid().replace(/-/g, ''));
  Logger.log('SECRET = ' + p.getProperty('SECRET'));
}

function secret_() { return PropertiesService.getScriptProperties().getProperty('SECRET'); }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

function doPost(e) {
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var data = {};
    try { data = JSON.parse(e.postData.contents); } catch (err) { data = e.parameter || {}; }
    if (e.parameter && e.parameter.k) {            // webhook da Kiwify: URL termina com ?k=SECRET
      if (e.parameter.k !== secret_()) return json_({ ok: false });
      return json_(venda_(data));
    }
    return json_(resposta_(data));
  } finally { lock.releaseLock(); }
}

function doGet(e) {
  var p = e.parameter || {};
  if (p.acao === 'aprovar' && p.k === secret_() && p.id) {
    var ok = enviarPorId_(p.id, 'aprovado manualmente');
    return HtmlService.createHtmlOutput(ok ? '<p style="font-family:Arial">Relatório enviado.</p>' : '<p style="font-family:Arial">Resposta não encontrada.</p>');
  }
  return HtmlService.createHtmlOutput('<p style="font-family:Arial">Raio-X Coruja ativo.</p>');
}

function venda_(d) {
  var c = d.Customer || d.customer || {};
  var prod = (d.Product || d.product || {}).product_name || '';
  var status = String(d.order_status || d.status || '').toLowerCase();
  var email = String(c.email || '').trim().toLowerCase();
  if (!email) return { ok: false, motivo: 'sem email' };
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Vendas');
  sh.appendRow([new Date(), d.order_id || '', status, email, c.full_name || c.name || '', prod, 0]);
  // se a escola respondeu antes do pagamento ser confirmado, envia agora
  if (status === 'paid' || status === 'approved') liberarPendentes_(email);
  return { ok: true };
}

function creditoDisponivel_(email) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Vendas');
  var v = sh.getDataRange().getValues();
  for (var i = 1; i < v.length; i++) {
    var st = String(v[i][2]);
    if (String(v[i][3]) === email && (st === 'paid' || st === 'approved') && Number(v[i][6]) === 0 &&
        String(v[i][5]).indexOf(PRODUTO) >= 0) return i + 1;
  }
  return 0;
}

function resposta_(d) {
  if (d.website) return { ok: true }; // honeypot anti-spam
  var email = String(d.email || '').trim().toLowerCase();
  if (!email || !d.consentimento) return { ok: false, motivo: 'dados incompletos' };
  var resp = {};
  for (var i = 1; i <= 20; i++) resp['q' + i] = Number(d['q' + i]);
  var r = RX.calcular(CONFIG, resp);
  var id = Utilities.getUuid().slice(0, 8);
  var notas = {}; r.areas.forEach(function (a) { notas[a.id] = a.nota; });
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Respostas');
  sh.appendRow([new Date(), id, 'pendente', email, d.nome, d.cargo, d.instituicao, d.tipo, d.alunos, d.cidade, r.geral, r.nivel.nome,
    notas.contato, notas.visita, notas.relacionamento, notas.rematricula, notas.pedagogico, d.a1, d.a2, d.a3, d.a4, JSON.stringify(d)]);
  var linha = creditoDisponivel_(email);
  if (linha) { enviarPorId_(id, 'pago'); return { ok: true, status: 'enviado' }; }
  var link = ScriptApp.getService().getUrl() + '?acao=aprovar&k=' + secret_() + '&id=' + id;
  GmailApp.sendEmail(ADMIN, 'Raio-X pendente de pagamento · ' + d.instituicao,
    'Resposta sem compra encontrada para ' + email + '. Para enviar mesmo assim: ' + link,
    { htmlBody: '<p>Resposta recebida, mas não encontrei compra aprovada para <b>' + RX.esc(email) + '</b>.</p><p><a href="' + link + '">Enviar o relatório mesmo assim</a> (use se a compra foi feita com outro e-mail).</p>' + RX.adminHtml(CONFIG, d, r, 'pendente'), name: 'Raio-X Coruja' });
  return { ok: true, status: 'pendente' };
}

function liberarPendentes_(email) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Respostas');
  var v = sh.getDataRange().getValues();
  for (var i = 1; i < v.length; i++) {
    if (String(v[i][3]) === email && v[i][2] === 'pendente' && creditoDisponivel_(email)) enviarPorId_(String(v[i][1]), 'pago');
  }
}

function enviarPorId_(id, motivo) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Respostas');
  var v = sh.getDataRange().getValues();
  for (var i = 1; i < v.length; i++) {
    if (String(v[i][1]) !== id) continue;
    var d = JSON.parse(v[i][21]);
    var resp = {}; for (var q = 1; q <= 20; q++) resp['q' + q] = Number(d['q' + q]);
    var r = RX.calcular(CONFIG, resp);
    var opts = { htmlBody: RX.relatorioHtml(CONFIG, d, r), name: 'Coruja Criativa Tech', replyTo: ADMIN };
    if (GmailApp.getAliases().indexOf(REMETENTE) >= 0) opts.from = REMETENTE;
    GmailApp.sendEmail(d.email, 'Seu Raio-X Coruja · ' + d.instituicao + ' · nota ' + r.geral, RX.relatorioTexto(CONFIG, d, r), opts);
    GmailApp.sendEmail(ADMIN, 'Novo Raio-X enviado · ' + d.instituicao + ' · nota ' + r.geral, 'Ver HTML',
      { htmlBody: RX.adminHtml(CONFIG, d, r, 'enviado (' + motivo + ')'), name: 'Raio-X Coruja', replyTo: d.email });
    sh.getRange(i + 1, 3).setValue('enviado');
    // consome o crédito da compra
    var linha = creditoDisponivel_(String(d.email).trim().toLowerCase());
    if (linha) SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Vendas').getRange(linha, 7).setValue(1);
    return true;
  }
  return false;
}

// Teste manual no editor: envia um relatório de exemplo para o ADMIN
function testeEnvio() {
  var d = { nome: 'Teste Coruja', instituicao: 'Escola Teste', email: ADMIN, a1: 'Exemplo de desafio.' };
  for (var q = 1; q <= 20; q++) d['q' + q] = q % 4;
  var r = RX.calcular(CONFIG, d);
  GmailApp.sendEmail(ADMIN, 'TESTE · Raio-X Coruja · nota ' + r.geral, RX.relatorioTexto(CONFIG, d, r), { htmlBody: RX.relatorioHtml(CONFIG, d, r), name: 'Coruja Criativa Tech' });
}
